+    // Exploration-only label-first seeding: if the caller supplies a posting
+    // list (rare labels), compute PQ distances for all its nodes and keep the
+    // best L as the initial frontier. The normal pre-I/O filter and exact rerank
+    // still run, so filtering semantics are unchanged.
+    if (seed_ids != nullptr && !seed_ids->empty()) {
+      const size_t seed_limit = std::min((size_t) effective_lsearch, (size_t) seed_limit_env);
+      std::priority_queue<Neighbor> seed_heap;
+      size_t i = 0;
+      while (i < seed_ids->size()) {
+        size_t n = std::min((size_t) MAX_N_EDGES, seed_ids->size() - i);
+        nbr_handler->compute_dists(query_buf, seed_ids->data() + i, (unsigned) n);
+        for (size_t j = 0; j < n; ++j) {
+          uint32_t id = (*seed_ids)[i + j];
+          if (visited.find(id) != visited.end()) continue;
+          seed_heap.push(Neighbor(id, dist_scratch[j], true));
+          if (seed_heap.size() > seed_limit) seed_heap.pop();
+        }
+        i += n;
+      }
+      if (stats != nullptr) {
+        stats->n_seed_candidates += (double) seed_ids->size();
+        stats->n_cmps += (double) seed_ids->size();
+      }
+
+      std::vector<Neighbor> merged;
+      merged.reserve(seed_limit + cur_list_size);
+      for (unsigned j = 0; j < cur_list_size; ++j) merged.push_back(retset[j]);
+      while (!seed_heap.empty()) {
+        merged.push_back(seed_heap.top());
+        seed_heap.pop();
+      }
+      std::sort(merged.begin(), merged.end());
+
+      cur_list_size = 0;
+      for (const Neighbor &nn : merged) {
+        if (cur_list_size >= seed_limit) break;
+        bool duplicate = false;
+        for (unsigned j = 0; j < cur_list_size; ++j) {
+          if (retset[j].id == nn.id) {
+            duplicate = true;
+            break;
+          }
+        }
+        if (duplicate) continue;
+        retset[cur_list_size++] = nn;
+        visited.insert(nn.id);
+      }
+      if (stats != nullptr) {
+        stats->n_seed_inserted += (double) cur_list_size;
+        for (unsigned j = 0; j < cur_list_size; ++j) {
+          if (this->check_filter(retset[j].id, filter_data)) stats->n_seed_valid++;
+        }
+      }
+    }
