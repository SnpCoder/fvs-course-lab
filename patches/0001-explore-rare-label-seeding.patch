     // First pass: count non-zero entries per row
@@ -137,12 +138,63 @@ class SpmatFilterStore {
 
   bool loaded() const { return n_nodes_ > 0; }
   size_t size() const { return n_nodes_; }
+  size_t n_cols() const { return n_cols_; }
+
+  // Build label -> sorted node-ID postings once. This is an exploration-only
+  // side structure: it costs ~43 MiB for the 1M YFCC base and is not built in
+  // the original baseline path.
+  void build_inverted() {
+    if (inverted_built_ || n_nodes_ == 0 || n_cols_ == 0) return;
+    label_offsets_.assign(n_cols_ + 1, 0);
+    for (uint32_t label : labels_) {
+      if (label < n_cols_) label_offsets_[label + 1]++;
+    }
+    for (uint32_t label = 0; label < n_cols_; ++label) {
+      label_offsets_[label + 1] += label_offsets_[label];
+    }
+    label_ids_.resize(total_labels_);
+    std::vector<uint64_t> pos(label_offsets_.begin(), label_offsets_.end() - 1);
+    for (uint32_t node = 0; node < n_nodes_; ++node) {
+      for (int64_t j = indptr_[node]; j < indptr_[node + 1]; ++j) {
+        uint32_t label = labels_[j];
+        if (label < n_cols_) label_ids_[pos[label]++] = node;
+      }
+    }
+    inverted_built_ = true;
+    double mem_mb = (label_offsets_.size() * 8 + label_ids_.size() * 4) / (1024.0 * 1024.0);
+    LOG(INFO) << "SpmatFilterStore inverted index: " << n_cols_ << " labels, "
+              << label_ids_.size() << " postings, " << std::fixed << std::setprecision(1)
+              << mem_mb << " MB";
+  }
+
+  bool inverted() const { return inverted_built_; }
+
+  // Returns a pointer to the sorted node IDs containing label; n=0 if absent.
+  const uint32_t *posting(uint32_t label, uint32_t &n) const {
+    if (!inverted_built_ || label >= n_cols_) {
+      n = 0;
+      return nullptr;
+    }
+    uint64_t begin = label_offsets_[label];
+    uint64_t end = label_offsets_[label + 1];
+    n = (uint32_t) (end - begin);
+    return label_ids_.data() + begin;
+  }
+
+  size_t posting_size(uint32_t label) const {
+    if (!inverted_built_ || label >= n_cols_) return 0;
+    return (size_t) (label_offsets_[label + 1] - label_offsets_[label]);
+  }
 
  private:
   uint32_t n_nodes_ = 0;
+  uint32_t n_cols_ = 0;
   int64_t total_labels_ = 0;
+  bool inverted_built_ = false;
   std::vector<int64_t> indptr_;     // n_nodes+1 entries
   std::vector<uint32_t> labels_;    // flattened sorted labels
+  std::vector<uint64_t> label_offsets_;  // n_cols+1
+  std::vector<uint32_t> label_ids_;      // total_labels postings
 };
 
 }  // namespace pipeann
